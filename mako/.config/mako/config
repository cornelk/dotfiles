font=DejaVu Sans Mono 10
background-color=#282828
text-color=#ebdbb2
border-color=#458588
border-size=2
border-radius=0
padding=8
default-timeout=5000
history=0
max-history=0
max-visible=5

# Keep the notification service available for applications, but never render
# popup banners. Separate urgency criteria cover every notification.
[urgency=low]
invisible=1

[urgency=normal]
invisible=1

[urgency=critical]
invisible=1
