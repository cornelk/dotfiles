# Sway config

set $mod Mod4
set $term kitty
set $menu wofi --show drun
set $browser firefox

set $bg #282828
set $fg #ebdbb2
set $red #cc241d
set $green #98971a
set $yellow #d79921
set $blue #458588
set $purple #b16286
set $aqua #689d6a
set $gray #a89984
set $darkgray #1d2021

font pango:monospace 11

default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart
gaps inner 2
gaps outer 0
smart_gaps on
focus_follows_mouse no

client.focused          $blue     $blue      $fg     $purple    $blue
client.focused_inactive $darkgray $darkgray  $gray   $purple    $darkgray
client.unfocused        $darkgray $darkgray  $gray   $purple    $darkgray
client.urgent           $red      $red       $fg      $red       $red

output * bg #1d2021 solid_color

input * {
    xkb_layout us,us
    xkb_variant colemak,
    xkb_options caps:none,grp:win_space_toggle
    repeat_delay 660
    repeat_rate 25
}

input type:touchpad {
    tap enabled
    natural_scroll disabled
    middle_emulation disabled
}

exec_always --no-startup-id "$HOME/.config/sway/start-session-services.sh"

exec dex --autostart --environment sway
exec --no-startup-id "$HOME/.config/sway/disable-screen-lock.sh"
exec_always --no-startup-id swaymsg "output * dpms on"
exec mako
exec nm-applet --indicator
exec blueman-applet
exec_always --no-startup-id "$HOME/.config/waybar/launch.sh"
exec_always --no-startup-id "$HOME/.config/sway/focus-last-window.sh" --daemon

for_window [app_id="scratch"] move scratchpad
exec $term --class scratch

bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+f exec thunar
bindsym $mod+Ctrl+a exec pavucontrol
bindsym $mod+p exec wdisplays
bindsym $mod+u [app_id="scratch"] scratchpad show

bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit Sway?' -b 'Yes, exit' 'swaymsg exit'

bindcode --release 66 workspace back_and_forth
bindcode --release Mod1+66 exec --no-startup-id "$HOME/.config/sway/focus-last-window.sh" --toggle

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+bar splith
bindsym $mod+v splitv
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+Ctrl+space focus mode_toggle
bindsym $mod+a focus parent

bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

bindsym Print exec grim "$HOME/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S_screenshot.png)"
bindsym $mod+Print exec grim -g "$(slurp)" "$HOME/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S_screenshot.png)"
bindsym $mod+Shift+Print exec grim -g "$(swaymsg -t get_tree | jq -r '.. | select(.focused? == true) | .rect | \"\(.x),\(.y) \(.width)x\(.height)\"')" "$HOME/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S_screenshot.png)"

bindsym $mod+Shift+x exec swaylock -f

bindsym XF86MonBrightnessUp exec brightnessctl set +10%
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1; workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2; workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3; workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4; workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5; workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6; workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7; workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8; workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9; workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10; workspace number $ws10

bindsym $mod+Tab workspace back_and_forth
bindsym $mod+x move workspace to output right

assign [app_id="firefox"] $ws1
assign [app_id="thunar"] $ws4

mode "resize" {
    bindsym j resize shrink width 30 px
    bindsym k resize grow height 30 px
    bindsym l resize shrink height 30 px
    bindsym semicolon resize grow width 30 px

    bindsym Left resize shrink width 30 px
    bindsym Down resize grow height 30 px
    bindsym Up resize shrink height 30 px
    bindsym Right resize grow width 30 px

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"
